# === PostgreSQL ===
POSTGRES_USER=dance
# openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=dance_saas

# === JWT ===
# openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_STRING

# === CORS ===
# Stage A (IP mode):   http://<ECS_PUBLIC_IP>
# Stage B (Domain):    https://admin.yourdomain.com
CORS_ORIGINS=https://admin.yourdomain.com

# === WeChat MiniProgram ===
# From mp.weixin.qq.com > Development > Development Management
WECHAT_APP_ID=
WECHAT_SECRET=

# === File Storage (Aliyun OSS) ===
# 生产强制 oss（local 会在启动时直接报错拦截）
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_REGION=cn-shanghai
OSS_BUCKET=class-booking-system-prod
# ecs_role = ECS 实例 RAM 角色（推荐，STS 临时凭证自动刷新，AK/SK 不落盘）
# static   = 静态 AccessKey（仅临时排障使用）
OSS_CREDENTIALS_MODE=ecs_role
# ecs_role 模式必填：与 ECS 实例绑定的 RAM 角色名
OSS_ROLE_NAME=class-booking-oss-role
# 预签名 URL 有效期（秒），默认 3600（1 小时），上限 604800（7 天）
OSS_PRESIGN_TTL_SECONDS=3600
# 前置云侧配置（不在本文件生效，需在阿里云控制台完成）：
#   1) RAM 角色信任策略允许 ECS 服务扮演（ecs.aliyuncs.com）
#   2) RAM 角色被授予目标 Bucket 的读写权限
#   3) ECS 实例已绑定该 RAM 角色

# === Domains (for CI/CD Nginx config) ===
ADMIN_DOMAIN=admin.yourdomain.com
API_DOMAIN=api.yourdomain.com