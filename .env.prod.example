# === Application ===
APP_NAME=dance-saas
APP_ENV=production
APP_DEBUG=false

# === Server ===
API_HOST=0.0.0.0
API_PORT=8000

# === Database ===
POSTGRES_USER=dance
POSTGRES_PASSWORD=change_me_to_strong_password
POSTGRES_DB=dance_saas
DATABASE_URL=postgresql+asyncpg://dance:change_me_to_strong_password@postgres:5432/dance_saas

# === Redis ===
# 生产必须设置强密码（建议 openssl rand -base64 32），docker-compose.prod.yml 中
# redis 服务以 --requirepass ${REDIS_PASSWORD} 启动，api 通过 REDIS_URL 自动携带
REDIS_PASSWORD=change_me_to_strong_password

# === JWT ===
JWT_SECRET=change_me_to_strong_jwt_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === RBAC ===
# false = 执行真实权限校验（生产必须 false）
PERMISSION_CHECK_BYPASS=false

# === CORS ===
CORS_ORIGINS=https://admin.yourdomain.com,https://student.yourdomain.com,https://teacher.yourdomain.com

# === Domains (for CI/CD Nginx config) ===
ADMIN_DOMAIN=admin.yourdomain.com
API_DOMAIN=api.yourdomain.com

# === WeChat MiniProgram ===
# From mp.weixin.qq.com > Development > Development Management > Development Settings
# ⚠️ DO NOT commit real values! Use placeholder only.
WECHAT_APP_ID=your_wechat_app_id_here
WECHAT_SECRET=your_wechat_app_secret_here
