# Copy this file to .env.local and fill in real values
# cp .env.example .env.local

# Backend API base URL
# Local dev:       http://<your_local_ip>:8000/api/v1
# Stage A (IP):    http://<ECS_PUBLIC_IP>/api/v1
# Stage B (Prod):  https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=https://api.yourdomain.com/api/v1

# WeChat MiniProgram AppID (from mp.weixin.qq.com)
VITE_WECHAT_APPID=your_wechat_appid

# WeChat Secret is used ONLY on backend - do NOT put it in frontend env
# Set WECHAT_SECRET in infra/docker/.env.prod