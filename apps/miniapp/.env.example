# ============================================================
# 环境变量说明
# ============================================================
# .env                  - 所有环境生效（生产环境默认值）
# .env.development      - 仅 npm run dev 时生效（本地开发）
# .env.production       - 仅 npm run build 时生效（生产构建）
# .env.local            - 本地覆盖，git 忽略，优先级最高
# ============================================================

# 后端 API 地址
# 本地开发:  http://localhost:8000/api/v1
# 生产环境:  https://api.seplume.com/api/v1
VITE_API_BASE_URL=https://api.seplume.com/api/v1

# 注意：WECHAT_APPID 和 WECHAT_SECRET 不要放在前端 env 中
# WECHAT_APPID 在 manifest.json 的 mp-weixin.appid 中配置
# WECHAT_SECRET 只在后端 .env.prod 中配置