# === Application ===
APP_NAME=dance-saas
APP_ENV=development
APP_DEBUG=true

# === Server ===
API_HOST=0.0.0.0
API_PORT=8000

# === Database ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dance
POSTGRES_PASSWORD=dance_dev_pass
POSTGRES_DB=dance_saas
DATABASE_URL=postgresql+asyncpg://dance:dance_dev_pass@localhost:5432/dance_saas

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
# 生产环境必须设置强密码；开发环境可留空
REDIS_PASSWORD=

# === JWT ===
JWT_SECRET=please_change_me_in_production_use_openssl_rand
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === RBAC ===
# false = 执行真实权限校验（生产必须 false）；仅本地调试可临时置 true
PERMISSION_CHECK_BYPASS=false

# === CORS ===
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# === Domains (for CI/CD Nginx config) ===
ADMIN_DOMAIN=admin.yourdomain.com
API_DOMAIN=api.yourdomain.com

# === WeChat MiniProgram ===
# From mp.weixin.qq.com > Development > Development Management > Development Settings
# ⚠️ DO NOT commit real values! Use placeholder only.
WECHAT_APP_ID=your_wechat_app_id_here
WECHAT_SECRET=your_wechat_app_secret_here