# === Application ===
APP_NAME=dance-saas
APP_ENV=development
APP_DEBUG=true
# 时区（Docker 部署时注入容器；数据库仍用 timestamptz 存绝对时间）
TZ=Asia/Shanghai

# === Server ===
API_HOST=0.0.0.0
API_PORT=8000

# === Database ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dance
POSTGRES_PASSWORD=dance_dev_pass
POSTGRES_DB=dance_saas
DATABASE_URL=postgresql+asyncpg://dance:dance_dev_pass@localhost:5432/dance_saas

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
# 生产环境必须设置强密码；开发环境可留空
REDIS_PASSWORD=
# JWT 黑名单（登出 / 轮换时写入 jti）；key 前缀可按需调整
ENABLE_TOKEN_BLACKLIST=true
REDIS_TOKEN_BLACKLIST_PREFIX=blacklist:

# === JWT ===
JWT_SECRET=please_change_me_in_production_use_openssl_rand
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === RBAC ===
# false = 执行真实权限校验（生产必须 false）；仅本地调试可临时置 true
PERMISSION_CHECK_BYPASS=false

# === CORS ===
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# === Domains (for CI/CD Nginx config) ===
ADMIN_DOMAIN=admin.yourdomain.com
API_DOMAIN=api.yourdomain.com

# === WeChat MiniProgram ===
# From mp.weixin.qq.com > Development > Development Management > Development Settings
# ⚠️ DO NOT commit real values! Use placeholder only.
WECHAT_APP_ID=your_wechat_app_id_here
WECHAT_SECRET=your_wechat_app_secret_here

# === File Storage ===
# local = 写本地磁盘（仅开发；生产环境启动即报错拦截）
# oss   = 阿里云 OSS（alibabacloud-oss-v2 原生 async）
STORAGE_BACKEND=local
# LOCAL_UPLOAD_DIR 不填则用默认值 <repo>/.uploads；填相对路径以启动 cwd 为基准，慎用
# LOCAL_UPLOAD_DIR=/absolute/path/to/uploads
LOCAL_UPLOAD_PUBLIC_URL_PREFIX=/uploads

# --- 以下仅在 STORAGE_BACKEND=oss 时必填 ---
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_REGION=cn-shanghai
OSS_BUCKET=class-booking-system-prod

# 凭证模式：
#   ecs_role = ECS 实例 RAM 角色（生产推荐，STS 临时凭证自动刷新，AK/SK 不落盘）
#   static   = 静态 AccessKey（本地开发/CI）
OSS_CREDENTIALS_MODE=ecs_role
# ecs_role 模式必填：与 ECS 实例绑定的 RAM 角色名
OSS_ROLE_NAME=class-booking-oss-role
# static 模式必填（ecs_role 模式下留空）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 私有 Bucket 不需要此项：访问地址由后端签发预签名 URL（有效期见 OSS_PRESIGN_TTL_SECONDS）
# 仅当 bucket 允许公共读并挂了 CDN 时才填写
OSS_PUBLIC_BASE_URL=
# 预签名 URL 有效期（秒）：默认 3600（1 小时），上限 604800（7 天）
# 前端在图片加载失败时应调用 GET /api/v1/upload/url/{object_key} 换新链接
OSS_PRESIGN_TTL_SECONDS=3600

# === 后台定时任务 ===
# 课程结束后自动置为已完成（宽限期：结束后多少分钟内仍可签到）
AUTO_FINISH_ENABLED=true
AUTO_FINISH_GRACE_MINUTES=30
# 人数不足自动取消课程
AUTO_CANCEL_UNDERBOOKED_ENABLED=true
# PENDING 期会员卡超期未激活自动作废
PENDING_CARD_CANCEL_ENABLED=true
PENDING_CARD_CANCEL_DAYS=90

# === 异步任务队列（JobQueue Worker） ===
# 总开关：false 走旧同步扫描；true 时排期直写扫描下线，由 Worker 消费延迟任务
# 灰度上线顺序见 docs/ai/plans/03-scheduling-realtime.md 阶段 6
TASK_WORKER_ENABLED=false
# 每轮 claim 批量 / 租约超时（秒）/ 最大重试次数 / 主循环 tick 间隔（秒）
TASK_WORKER_BATCH_SIZE=20
TASK_WORKER_LEASE_SECONDS=120
TASK_WORKER_MAX_ATTEMPTS=3
TASK_WORKER_TICK_SECONDS=1.0

# === 实时推送（SSE / WebSocket） ===
# 心跳间隔（秒），客户端侧空闲超时应大于该值
NOTIFY_HEARTBEAT_SECONDS=25
# 单用户最大并发连接数（超限 SSE 429 / WS 4429）
NOTIFY_MAX_CONNECTIONS_PER_USER=3
# 单用户每秒最多投递信号数（超限丢弃，前端凭 HTTP 补齐）
NOTIFY_MAX_EVENTS_PER_SECOND=20

# === AI 对话限流（按登录用户，仅作用于 /api/v1/ai/chat） ===
AI_CHAT_RATE_LIMIT=20
AI_CHAT_RATE_WINDOW=60

# === AI LLM（火山方舟，默认关闭） ===
# 关闭时 AI 助手完全走本地规则链路，行为与未接入 LLM 时一致
AI_LLM_ENABLED=false
# 方舟密钥：只能通过环境变量注入，禁止提交明文
ARK_API_KEY=
# OpenAI 兼容数据面地址（生产出网需放行该域名 443）
AI_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 实际调用模型（必须在 AI_LLM_ALLOWED_MODELS 白名单内）
AI_LLM_MODEL=doubao-seed-2-1-lite-260915
# 模型白名单（逗号分隔），防止误配高价/视频模型
AI_LLM_ALLOWED_MODELS=doubao-seed-2-1-lite-260915,doubao-seed-2-1-pro-260915,doubao-seed-2-0-lite-260428,doubao-seed-evolving
# 单次模型调用超时 / 单请求总预算（毫秒，前者必须小于后者）
AI_LLM_TIMEOUT_MS=6000
AI_LLM_TOTAL_BUDGET_MS=15000
# 输出 token 上限与最多重试次数（仅超时 / 429 / 5xx 重试）
AI_LLM_MAX_TOKENS=800
AI_LLM_MAX_RETRIES=2
AI_LLM_MAX_TOOL_LOOPS=4
# 上下文裁剪：历史消息条数上限 / 字符预算（双限，优先保留最近消息）
AI_LLM_HISTORY_LIMIT=6
AI_LLM_HISTORY_MAX_CHARS=2000
# 只读闸门：true 时写工具不进入模型可见工具集
AI_LLM_READONLY_ONLY=true
# 写操作 Agent 总开关（需 READONLY_ONLY=false 同时满足；默认关闭）
AI_LLM_WRITE_TOOLS=false
# 租户灰度白名单（逗号分隔），空表示不启用
AI_LLM_ENABLED_TENANTS=
# 会员续费预警（站内消息）：默认关闭，按租户灰度
AI_RENEWAL_ALERT_ENABLED=false
AI_RENEWAL_ALERT_DAYS=7
AI_RENEWAL_ALERT_CREDITS_THRESHOLD=3
AI_RENEWAL_ALERT_MAX_PER_DAY=50
AI_RENEWAL_ALERT_TENANTS=
