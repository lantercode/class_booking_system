# === Application ===
APP_NAME=dance-saas
APP_ENV=development
APP_DEBUG=true

# === Server ===
API_HOST=0.0.0.0
API_PORT=8000

# === Database ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dance
POSTGRES_PASSWORD=dance_dev_pass
POSTGRES_DB=dance_saas
DATABASE_URL=postgresql+asyncpg://dance:dance_dev_pass@localhost:5432/dance_saas

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
# 生产环境必须设置强密码；开发环境可留空
REDIS_PASSWORD=

# === JWT ===
JWT_SECRET=please_change_me_in_production_use_openssl_rand
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# === RBAC ===
# false = 执行真实权限校验（生产必须 false）；仅本地调试可临时置 true
PERMISSION_CHECK_BYPASS=false

# === CORS ===
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# === Domains (for CI/CD Nginx config) ===
ADMIN_DOMAIN=admin.yourdomain.com
API_DOMAIN=api.yourdomain.com

# === WeChat MiniProgram ===
# From mp.weixin.qq.com > Development > Development Management > Development Settings
# ⚠️ DO NOT commit real values! Use placeholder only.
WECHAT_APP_ID=your_wechat_app_id_here
WECHAT_SECRET=your_wechat_app_secret_here

# === File Storage ===
# local = 写本地磁盘（仅开发；生产环境启动即报错拦截）
# oss   = 阿里云 OSS（alibabacloud-oss-v2 原生 async）
STORAGE_BACKEND=local
# LOCAL_UPLOAD_DIR 不填则用默认值 <repo>/.uploads；填相对路径以启动 cwd 为基准，慎用
LOCAL_UPLOAD_PUBLIC_URL_PREFIX=/uploads

# --- 以下仅在 STORAGE_BACKEND=oss 时必填 ---
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_REGION=cn-shanghai
OSS_BUCKET=class-booking-system-prod

# 凭证模式：
#   ecs_role = ECS 实例 RAM 角色（生产推荐，STS 临时凭证自动刷新，AK/SK 不落盘）
#   static   = 静态 AccessKey（本地开发/CI）
OSS_CREDENTIALS_MODE=ecs_role
# ecs_role 模式必填：与 ECS 实例绑定的 RAM 角色名
OSS_ROLE_NAME=class-booking-oss-role
# static 模式必填（ecs_role 模式下留空）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 私有 Bucket 不需要此项：访问地址由后端签发预签名 URL（有效期见 OSS_PRESIGN_TTL_SECONDS）
# 仅当 bucket 允许公共读并挂了 CDN 时才填写
OSS_PUBLIC_BASE_URL=
# 预签名 URL 有效期（秒）：默认 3600（1 小时），上限 604800（7 天）
# 前端在图片加载失败时应调用 GET /api/v1/upload/url/{object_key} 换新链接
OSS_PRESIGN_TTL_SECONDS=3600